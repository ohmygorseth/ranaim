rules_version = '2';

// ============================================================
// GRUNNLEGGENDE SCOREVALIDERING
// ============================================================
// Nivå: "grunnleggende validering" - stopper useriøs/åpenbar
// juks (urealistiske tall), men er ikke vanntett mot en
// teknisk kyndig person som virkelig prøver å jukse.
//
// Validering er generisk (gjelder alle moduser) siden ulike
// moduser har ulike ekstra felt (f.eks. hits/shots i Gridshot,
// ingen tilsvarende felt i Tracking).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidScoreEntry() {
      let d = request.resource.data;
      return d.nickname is string
        && d.nickname.size() > 0
        && d.nickname.size() <= 20
        && d.modeId is string
        && d.score is number
        && d.score >= 0
        && d.score <= 30000; // generøs øvre grense på tvers av moduser
    }

    match /groups/{groupId}/modes/{modeId}/weekly/{weekId}/entries/{entryId} {
      allow read: if true;
      allow write: if isValidScoreEntry();
    }

    match /groups/{groupId}/modes/{modeId}/alltime/{entryId} {
      allow read: if true;
      allow write: if isValidScoreEntry();
    }

    match /globalAllTime/{modeId}/entries/{entryId} {
      allow read: if true;
      allow write: if isValidScoreEntry();
    }
  }
}
